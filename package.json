{
  "name": "starter-ionic-capacitor-tailwind-ts",
  "version": "0.0.1",
  "author": "utsavdotpro",
  "private": true,
  "scripts": {
    "start": "vite dev --port 3000 --host",
    "build": "vite build",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "ios": "npx ionic capacitor run ios --livereload --external --port 3000",
    "ios:build": "npx ionic capacitor build ios",
    "android": "npx ionic capacitor run android --livereload --external --port 3000",
    "android:build": "npx ionic capacitor build android",
    "ios:open": "npx ionic capacitor open ios",
    "android:open": "npx ionic capacitor open android",
    "ionic:serve": "pnpm start",
    "ionic:build": "pnpm build",
    "sync": "npx ionic capacitor sync",
    "postinstall": "pnpm sync"
  },
  "browserslist": [
    "Chrome >=79",
    "ChromeAndroid >=79",
    "Firefox >=70",
    "Edge >=79",
    "Safari >=14",
    "iOS >=14"
  ],
  "dependencies": {
    "@capacitor/android": "^8.0.2",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^8.0.2",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/ios": "^8.0.2",
    "@capacitor/keyboard": "^6.0.1",
    "@capacitor/status-bar": "^6.0.0",
    "@ionic/react": "8.7.17",
    "@ionic/react-router": "8.7.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^26.0.24",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4",
    "typescript": "^5.9.3",
    "web-vitals": "^0.2.4",
    "workbox-core": "^7.0.0",
    "workbox-expiration": "^7.0.0",
    "workbox-precaching": "^7.0.0",
    "workbox-routing": "^7.0.0",
    "workbox-strategies": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.2",
    "@eslint/js": "^9.24.0",
    "@ionic/cli": "^7.2.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20.14.8",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.24.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^4.1.18",
    "tailwindcss-safe-area": "^0.5.1",
    "typescript-eslint": "^8.29.1",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^0.20.0",
    "vite-plugin-svgr": "^4.2.0",
    "vite-tsconfig-paths": "^4.3.2"
  },
  "description": "Starter template for Ionic Capacitor app with TailwindCSS in TypeScript"
}